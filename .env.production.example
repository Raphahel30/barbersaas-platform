# ==============================================================================
# MATRIZ DEFINITIVA DE VARIÁVEIS DE AMBIENTE - PRODUÇÃO (GO-LIVE)
# ==============================================================================
# Copie este arquivo para .env.production ou preencha diretamente no painel de
# Environment Variables da Vercel / VPS antes de publicar em produção.
#
# NUNCA comite valores reais em repositórios Git públicos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (BANCO DE DADOS POSTGRESQL, AUTH & REALTIME DE PRODUÇÃO)
# ------------------------------------------------------------------------------
# Obtido em: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://[SEU-PROJETO-PROD].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Chave secreta de serviço (Bypass RLS para backend e workers). NUNCA exponha no frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# String de conexão direta para migrações do Supabase CLI
SUPABASE_DATABASE_URL=postgresql://postgres:[SENHA-DB]@db.[SEU-PROJETO-PROD].supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. IDENTIDADE DO SUPER ADMINISTRADOR (PLATAFORMA SAAS)
# ------------------------------------------------------------------------------
# E-mail com privilégios absolutos e bypass de RLS validado na plataforma.
MASTER_ADMIN_EMAIL=rafaelcassu@gmail.com

# ------------------------------------------------------------------------------
# 3. DOMÍNIOS, WHITE-LABEL & URLS CANÔNICAS
# ------------------------------------------------------------------------------
# Domínio público base do SaaS (sem protocolo ou barra final)
NEXT_PUBLIC_ROOT_DOMAIN=barbeariaflow.com.br
# URL completa da aplicação principal
NEXT_PUBLIC_APP_URL=https://barbeariaflow.com.br

# ------------------------------------------------------------------------------
# 4. ASAAS - GATEWAY DE ASSINATURAS DO SAAS & SPLIT PIX DE PRODUÇÃO
# ------------------------------------------------------------------------------
# URL da API oficial de produção do Asaas
ASAAS_API_URL=https://api.asaas.com/v3
# Chave de API de Produção gerada em: Asaas > Minha Conta > Integrações > Gerar Chave de API
# OBRIGATÓRIO: Iniciar com $aact_ (NÃO use chaves de sandbox em produção!)
ASAAS_API_KEY=$aact_prod_000MzkwODA2MWY2OGM3MWRlMDU2NWM3MzJlNzZmNGZhZGY6OjNiOTI3NWY4LTYzZGItNGJiMS1iOTdlLTdmMmE4MDdiNzYxNDo6JGFhY2hfYTY4ZDMyYTEtZGY1ZS00ZDBiLTlkYWMtNmNjZmYyZDI3ZTIy
# Token secreto para validar a autenticidade dos webhooks disparados pelo Asaas
# (Configurado no painel do Asaas > Webhooks > URL: https://barbeariaflow.com.br/api/webhooks/asaas-saas)
ASAAS_WEBHOOK_TOKEN=whk_sec_asaas_prod_token_32chars
ASAAS_SAAS_WEBHOOK_TOKEN=whk_sec_asaas_prod_token_32chars
ASAAS_GATEWAY_WEBHOOK_TOKEN=whk_sec_asaas_gateway_token_32chars

# Credenciais OAuth do Asaas (caso habilite conexão OAuth para barbearias parceiras)
ASAAS_CLIENT_ID=
ASAAS_CLIENT_SECRET=
ASAAS_OAUTH_AUTHORIZE_URL=https://www.asaas.com/oauth/authorize
ASAAS_OAUTH_TOKEN_URL=https://api.asaas.com/v3/oauth/token

# ------------------------------------------------------------------------------
# 5. WEBPUSH NOTIFICATIONS (VAPID KEYS - PADRÃO RFC 8292 NIST P-256)
# ------------------------------------------------------------------------------
# Para gerar um novo par válido: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BExamplePublicKeyInBase64URLFormat65BytesExactNistP256UncompressedKeyStringHere87Chars==
VAPID_PRIVATE_KEY=ExamplePrivateKeyInBase64URLFormat32BytesExact43Chars=
VAPID_SUBJECT=mailto:suporte@barbeariaflow.com.br

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE FOR SAAS (SSL AUTOMÁTICO PARA DOMÍNIOS CUSTOMIZADOS WHITE-LABEL)
# ------------------------------------------------------------------------------
# Criado em: Cloudflare Dashboard > My Profile > API Tokens > Create Token (Zone:Custom Hostnames:Edit)
CLOUDFLARE_API_TOKEN=cf_token_com_permissao_custom_hostnames
CLOUDFLARE_ZONE_ID=id_hexadecimal_da_zona_na_cloudflare_32chars
# Subdomínio de fallback origin configurado no Cloudflare for SaaS apontando para cname.vercel-dns.com
CLOUDFLARE_FALLBACK_ORIGIN=app-origin

# ------------------------------------------------------------------------------
# 7. WHATSAPP ENGINE (EVOLUTION API + FALLBACK WA.ME NATIVO)
# ------------------------------------------------------------------------------
# URL da sua instância auto-hospedada da Evolution API (HTTPS obrigatório)
EVOLUTION_API_URL=https://whatsapp.barbeariaflow.com.br
EVOLUTION_API_KEY=sua_chave_global_da_evolution_api
EVOLUTION_INSTANCE_NAME=barbersaas-master
# OBS: Caso a Evolution API fique offline ou não esteja preenchida, o sistema
# aciona o fallback automático wa.me para abertura direta no WhatsApp.

# ------------------------------------------------------------------------------
# 8. SEGURANÇA, CRIPTOGRAFIA & ROTAÇÃO DE CHAVES
# ------------------------------------------------------------------------------
# Token de alta entropia para autenticar rotas de Cron Jobs (/api/cron/*)
# Gerar com: openssl rand -hex 24
CRON_SECRET=cron_sec_prod_9f8e7d6c5b4a3f2e1d0c9b8a7f6e5d4c

# Chave simétrica AES-256 para criptografia de backups externos (64 hex characters = 32 bytes)
# Gerar com: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Chave simétrica AES-256 para credenciais de pagamento das barbearias (32 bytes base64)
# Gerar com: openssl rand -base64 32
ENCRYPTION_KEY=vX4s89PzL2kQ1wRtY7uIo9pAmNbVcXxZ01234567890=

# Segredo para autenticação HMAC do fluxo OAuth de gateways
GATEWAY_OAUTH_STATE_SECRET=state_secret_hmac_sha256_prod_key_high_entropy

# ------------------------------------------------------------------------------
# 9. BACKUP EXTERNO CRIPTOGRAFADO (CLOUDFLARE R2 / AWS S3)
# ------------------------------------------------------------------------------
# Permite redundância de snapshots de dados em bucket seguro fora do banco
BACKUP_S3_ENDPOINT=https://[ACCOUNT_ID].r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=r2_access_key_id_producao
BACKUP_S3_SECRET_ACCESS_KEY=r2_secret_access_key_producao
BACKUP_S3_BUCKET=barbersaas-production-backups

# ------------------------------------------------------------------------------
# 10. GATEWAYS ALTERNATIVOS (OPCIONAL - CASO AS BARBEARIAS UTILIZEM MERCADO PAGO OU PAGSEGURO)
# ------------------------------------------------------------------------------
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_WEBHOOK_SECRET=
PAGSEGURO_CLIENT_ID=
PAGSEGURO_CLIENT_SECRET=
PAGSEGURO_WEBHOOK_TOKEN=
INFINITEPAY_CLIENT_ID=
INFINITEPAY_CLIENT_SECRET=
INFINITEPAY_WEBHOOK_TOKEN=
