NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Compatibilidade com projetos que ainda usam chaves JWT legadas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_TOKEN=your_asaas_api_token
ASAAS_WEBHOOK_TOKEN=your_asaas_webhook_token
ASAAS_CLIENT_ID=your_asaas_client_id
ASAAS_CLIENT_SECRET=your_asaas_client_secret
ASAAS_OAUTH_AUTHORIZE_URL=https://www.asaas.com/oauth/authorize
ASAAS_OAUTH_TOKEN_URL=https://api.asaas.com/v3/oauth/token

MERCADO_PAGO_CLIENT_ID=your_mercado_pago_client_id
MERCADO_PAGO_CLIENT_SECRET=your_mercado_pago_client_secret
PAGSEGURO_CLIENT_ID=your_pagseguro_client_id
PAGSEGURO_CLIENT_SECRET=your_pagseguro_client_secret
