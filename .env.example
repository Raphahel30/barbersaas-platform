PAGSEGURO_OAUTH_TOKEN_URL=https://api.pagseguro.com/oauth2/token
INFINITEPAY_CLIENT_ID=your_infinitepay_client_id
INFINITEPAY_CLIENT_SECRET=your_infinitepay_client_secret

EVOLUTION_API_URL=https://your-evolution-api.example.com
EVOLUTION_API_KEY=your_evolution_api_key

CRON_SECRET=replace_with_a_long_random_secret
ENCRYPTION_KEY=replace_with_a_32_byte_base64_key
GATEWAY_OAUTH_STATE_SECRET=replace_with_a_long_random_secret
MERCADO_PAGO_WEBHOOK_SECRET=your_mercado_pago_webhook_secret
ASAAS_GATEWAY_WEBHOOK_TOKEN=your_asaas_gateway_webhook_token
ASAAS_SAAS_WEBHOOK_TOKEN=your_asaas_saas_webhook_token
PAGSEGURO_WEBHOOK_TOKEN=your_pagseguro_webhook_token
INFINITEPAY_WEBHOOK_TOKEN=your_infinitepay_webhook_token
